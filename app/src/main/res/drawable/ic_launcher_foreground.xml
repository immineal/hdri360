<?xml version="1.0" encoding="utf-8"?>
<!--
    "360", drawn as three ribbons inside the sphere.

    His idea, from play/logoidea.svg: the digits as flowing forms that read as
    meridians on a globe as much as they read as a number. It fills the circular
    mask instead of merely being subdivided by it, and it has character that a
    grid of latitude and longitude lines does not.

    His paths, transformed once from the 210mm Inkscape page into this canvas -
    a uniform scale of 30/54.762459 about his circle's centre, landing on radius
    30 about (54, 54). The curves are his, to the fourth decimal.

    What is not his is the weight. The original strokes are 0.26 units, which is
    a hairline on an A4 page and nothing at all at 48dp: the whole mark would
    have disappeared into the background on a launcher. At 2.9 units it survives
    down to 96 pixels, checked by rendering it there and looking.

    The adaptive canvas is 108 units and only the middle 72 are guaranteed
    visible, so radius 30 sits well inside whatever crop a launcher chooses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The sphere. Lighter than the digits on purpose: it is what they sit in. -->
    <path
        android:strokeColor="#ECECEC"
        android:strokeWidth="2.8"
        android:pathData="M 24,54 a 30,30 0 1,0 60,0 a 30,30 0 1,0 -60,0 Z" />

    <!-- The 3. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 29.7658,44.5405 c 10.0850,-17.8616 19.8951,-7.9627 9.7297,9.1892
                          10.3205,19.7481 -2.6835,26.9921 -9.7297,7.3874" />

    <!-- The 6. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 63.2793,30.3063 c -7.2258,-3.6548 -18.8393,-2.5948 -17.2973,0.5405
                          13.2835,27.0086 -9.2376,50.1045 8.1081,49.9099
                          17.3457,-0.1946 12.1966,-24.8649 -3.9640,-24.8649" />

    <!-- The 0. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 71.2072,35.5315 c -3.5657,-2.0711 -5.3497,-2.0239 -7.5676,1.0811
                          -7.0924,9.9293 3.2042,16.1579 4.8649,26.4865
                          1.6147,10.0429 5.0000,11.9470 9.5495,2.1622
                          5.9425,-12.7807 -0.4539,-23.3367 -6.8468,-29.7297 z" />
</vector>
