<?xml version="1.0" encoding="utf-8"?>
<!--
    "360", drawn as three ribbons inside the sphere.

    His mark, from play/logo.svg, which is the editable original on this exact
    108 unit canvas - so the curves below are his to the sixth decimal and were
    copied without arithmetic. He revised them after seeing the first render at
    launcher size: the 3 is tighter, the weights across the three digits are more
    even, and the whole group sits closer inside the ring.

    The idea is the part worth keeping: the digits read as meridians on a globe
    as much as they read as a number, which fills the circular mask instead of
    merely being subdivided by it.

    The only thing here that is not from the drawing is why the strokes are this
    thick. His first version used 0.26 units, a hairline on an A4 page and
    nothing at all at 48dp - the mark disappeared into the background on a
    launcher. 2.9 survives down to 96 pixels, checked by rendering it there.

    Only the middle 72 units of the canvas are guaranteed visible, so radius 30
    about (54, 54) sits well inside whatever crop a launcher chooses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The sphere. Lighter than the digits on purpose: it is what they sit in. -->
    <path
        android:strokeColor="#ECECEC"
        android:strokeWidth="2.8"
        android:pathData="M 24,54 a 30,30 0 1,0 60,0 a 30,30 0 1,0 -60,0 Z" />

    <!-- The 3. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 30.949792,44.625071 c 8.731866,-19.214735 19.387675,-1.197027 9.222275,9.104629 9.559362,14.335561 -2.56141,26.192411 -9.7297,7.3874" />

    <!-- The 6. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 62.433591,30.475442 c -7.2258,-3.6548 -17.739878,-1.833662 -16.197878,1.301638 13.2835,27.0086 -8.086068,47.457344 7.854387,47.457344 19.376493,0 11.435462,-22.496915 -2.949149,-22.496915" />

    <!-- The 0. -->
    <path
        android:strokeColor="#FFC400"
        android:strokeWidth="2.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="m 63.779721,37.718032 c -7.0924,9.9293 0.367792,16.525076 6.59487,26.213298 6.227079,9.688223 12.26718,-13.21019 2.946882,-24.847752 -5.058499,-6.316171 -7.217576,-4.350076 -9.541752,-1.365546 z" />
</vector>
