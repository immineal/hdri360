<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Stitching a sphere is minutes of solid arithmetic and the process is
         an ordinary one now - see decision 15 - so the wake lock is what keeps it
         moving when the screen goes off. It does not survive the app being swiped
         away, and the app says so before, during and after. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The zenith is shot with the screen facing the floor; the only feedback
         a person can use up there is one they can feel. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.level.full" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- allowBackup is off deliberately. A capture is gigabytes of raw frames in
         the app's own storage, far past what Auto Backup will carry, so what
         would actually be backed up is the small metadata beside it - session
         headers, names, the intro flag. Restored onto a new phone that has none
         of the frames, that is a library full of rows pointing at captures which
         are not there. Better to restore nothing than the index of something
         missing. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Hdri360">

        <activity
            android:name=".ui.CaptureActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.ReviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Not a foreground service. Play requires a demonstration video for
             every branch of the FOREGROUND_SERVICE_DATA_SYNC declaration, which is
             a strange price for keeping arithmetic alive; decision 15 has the
             reasoning and what the app shows the person instead. -->
        <service
            android:name=".device.ProcessingService"
            android:exported="false" />
    </application>
</manifest>
